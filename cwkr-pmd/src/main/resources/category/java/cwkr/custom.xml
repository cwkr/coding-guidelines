<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Custom Java Rules"
        xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Custom Java Rules
    </description>

    <rule name="AvoidFinalizeMethod"
            language="java"
            message="Avoid using finalizer method"
            class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Oracle has declared Object.finalize() as deprecated since JDK 9.
        </description>
        <priority>2</priority>
        <properties>
            <property name="xpath">
                <value>
                    <![CDATA[//MethodDeclaration[@Name='finalize'][@Arity = 0]]]>
                </value>
            </property>
        </properties>
    </rule>

    <rule name="UseJavaTimeApi"
          language="java"
          message="Consider using Java Time API instead of java.util.Date, java.util.Calendar or java.text.SimpleDateFormat"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Please use the Java Time API instead of java.util.Date, java.util.Calendar or java.text.SimpleDateFormat in Java 8+
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[//ClassType[
        pmd-java:typeIsExactly('java.util.Date')
        or
        pmd-java:typeIsExactly('java.util.Calendar')
        or
        pmd-java:typeIsExactly('java.text.SimpleDateFormat')
            ]]]></value>
            </property>
        </properties>
    </rule>

    <rule name="UseCommonsStringUtils"
            language="java"
            message="Use org.apache.commons.lang3.StringUtils"
            class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Please use org.apache.commons.lang3.StringUtils instead of another StringUtils implementation
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[//ClassType[
        pmd-java:typeIsExactly('org.apache.commons.lang.StringUtils')
        or
        pmd-java:typeIsExactly('org.springframework.util.StringUtils')
        or
        pmd-java:typeIsExactly('org.junit.platform.commons.util.StringUtils')
        or
        pmd-java:typeIsExactly('org.apache.cxf.common.util.StringUtils')
            ]]]></value>
            </property>
        </properties>
    </rule>

    <rule name="UseSlf4j"
          language="java"
          message="Use org.slf4j.Logger instead of java.util.logging.Logger, org.apache.logging.log4j.Logger or org.apache.commons.logging.Log"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Please use org.slf4j.Logger instead of java.util.logging.Logger, org.apache.logging.log4j.Logger or org.apache.commons.logging.Log
        </description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
                //ClassType[
                    pmd-java:typeIsExactly('java.util.logging.Logger') or
                    pmd-java:typeIsExactly('org.apache.logging.log4j.Logger') or
                    pmd-java:typeIsExactly('org.apache.commons.logging.Log')
                ]
            ]]></value>
            </property>
        </properties>
    </rule>

</ruleset>
